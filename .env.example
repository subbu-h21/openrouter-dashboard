# Copy this file to .env (setup.bat does it for you). Never commit .env.

# Management key from https://openrouter.ai/settings/management-keys
# Used read-only by the server; never sent to the browser. Give it an expiry date.
OPENROUTER_MANAGEMENT_KEY=

# Dashboard login. Don't fill these in by hand: setup.bat (or `python -m app.set_login`
# from backend/) asks for a username and password and writes them here. Only a salted
# hash of the password is stored.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD_SALT=
DASHBOARD_PASSWORD_HASH=

# Optional: how often to pull new data from OpenRouter, in seconds (default 300)
# SYNC_INTERVAL_SECONDS=300
# Optional: how long a login lasts, in days (default 7)
# SESSION_DAYS=7
